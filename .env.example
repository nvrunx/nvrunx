OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Browser settings
BROWSER_USE_DEBUG=false
BROWSER_USE_HEADLESS=true
BROWSER_USE_DISABLE_SECURITY=false

# Logging
BROWSER_USE_DEBUG_LOG_FILE=
BROWSER_USE_INFO_LOG_FILE=

# Cloud settings
BROWSER_USE_CLOUD_API_URL=https://cloud.browser-use.com
BROWSER_USE_CLOUD_API_KEY=

# Telemetry
BROWSER_USE_TELEMETRY=true

# MCP settings
MCP_SERVER_NAME=browser-use

# Other settings
BROWSER_USE_MAX_ACTIONS=100
BROWSER_USE_MAX_RETRIES=3
BROWSER_USE_ACTION_TIMEOUT=30